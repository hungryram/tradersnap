# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# AI provider: "openai" (default) or "anthropic"
AI_PROVIDER=openai

# OpenAI
OPENAI_API_KEY=sk-...

# Anthropic (used when AI_PROVIDER=anthropic)
ANTHROPIC_API_KEY=sk-ant-...
# Optional overrides (default: claude-opus-5-5 for everything)
ANTHROPIC_MODEL=
ANTHROPIC_MODEL_FREE=

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID_PRO=price_...
STRIPE_PRICE_ID_UNLIMITED=price_...

# Admin usage endpoint (/api/admin/usage). Leave unset to disable it.
ADMIN_SECRET=

# Optional: HMAC key for chart tokens (defaults to SUPABASE_SERVICE_ROLE_KEY)
CHART_TOKEN_SECRET=

# App
ALLOWED_ORIGINS=chrome-extension://your-extension-id,http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
